# Copy this file to ".env" (same folder) and fill in what you need. Never commit the .env file.

# Your Anthropic API key. With a key, Claude decides the agent's steps and writes the summaries.
# Leave it empty to run without a key: the built-in planner calls the same tools and costs nothing.
ANTHROPIC_API_KEY=

# "auto" uses Claude when a key is set. "offline" never calls Claude, even if a key is set.
ACUMAIN_AGENT_MODE=auto

# Which Claude model the agent uses, and how much it thinks (low, medium or high).
ACUMAIN_MODEL=claude-sonnet-5-5
ACUMAIN_EFFORT=medium

# Spend limits in US dollars. When a limit is reached the agent carries on with the built-in planner.
ACUMAIN_DAILY_USD_LIMIT=10
ACUMAIN_RUN_USD_LIMIT=0.50

# The port the dashboard is published on when started with Docker Compose.
ACUMAIN_PUBLISHED_PORT=8787
